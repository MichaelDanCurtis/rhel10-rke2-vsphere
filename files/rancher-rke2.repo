# RKE2 RPM repositories for RHEL 10
# Change 1-32 to match your desired Kubernetes minor version (e.g. 1-33)

[rancher-rke2-common-latest]
name=Rancher RKE2 Common Latest
baseurl=https://rpm.rancher.io/rke2/latest/common/centos/10/noarch
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://rpm.rancher.io/public.key

[rancher-rke2-1-32-latest]
name=Rancher RKE2 1.32 Latest
baseurl=https://rpm.rancher.io/rke2/latest/1.32/centos/10/x86_64
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://rpm.rancher.io/public.key
